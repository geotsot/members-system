rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAuthorized() {
      return isVerified() && (request.auth.token.email == 'geotsot@gmail.com' || request.auth.token.email == 'pontiakossillogosfilirou@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Members Collection
    match /members/{memberId} {
      allow read: if isAuthorized();
      
      allow create: if isAuthorized() && 
                      isValidId(memberId) && 
                      incoming().keys().hasAll(['fullName', 'fatherName', 'birthDate', 'idNumber', 'registrationDate', 'active', 'memberType']) &&
                      (incoming().keys().size() >= 7 && incoming().keys().size() <= 10) &&
                      isValidMember(incoming());
                      
      allow update: if isAuthorized() && 
                      isValidId(memberId) &&
                      isValidMember(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'fatherName', 'birthDate', 'idNumber', 'registrationDate', 'active', 'memberType', 'isDanceMember', 'notes', 'statusHistory']);
                      
      allow delete: if isAuthorized() && isValidId(memberId);
    }

    function isValidMember(m) {
      // Note: Map.keys() returns a List, which does NOT support .hasOnly().
      return (!m.keys().hasAny(['fullName']) || (m.fullName is string && m.fullName.size() > 0 && m.fullName.size() < 200)) &&
             (!m.keys().hasAny(['fatherName']) || (m.fatherName is string && m.fatherName.size() < 200)) &&
             (!m.keys().hasAny(['birthDate']) || (m.birthDate is string)) &&
             (!m.keys().hasAny(['idNumber']) || (m.idNumber is string && m.idNumber.size() < 100)) &&
             (!m.keys().hasAny(['registrationDate']) || (m.registrationDate is string)) &&
             (!m.keys().hasAny(['active']) || (m.active is bool)) &&
             (!m.keys().hasAny(['memberType']) || (m.memberType in ['member', 'friend'])) &&
             (!m.keys().hasAny(['isDanceMember']) || (m.isDanceMember is bool)) &&
             (!m.keys().hasAny(['notes']) || (m.notes is string)) &&
             (!m.keys().hasAny(['statusHistory']) || (m.statusHistory is list));
    }

    // 2. Payments Collection
    match /payments/{paymentId} {
      allow read: if isAuthorized();
      
      allow create: if isAuthorized() && 
                      isValidId(paymentId) && 
                      incoming().keys().hasAll(['memberId', 'amount', 'date', 'period', 'type']) &&
                      incoming().keys().size() == 5 &&
                      isValidPayment(incoming()) &&
                      // Relational Sync: Member must exist
                      exists(/databases/$(database)/documents/members/$(incoming().memberId));
                      
      allow update: if isAuthorized() && 
                      isValidId(paymentId) &&
                      isValidPayment(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'date', 'period', 'type']) &&
                      // Identity Integrity: memberId is immutable
                      incoming().memberId == existing().memberId;
                      
      allow delete: if isAuthorized() && isValidId(paymentId);
    }

    function isValidPayment(p) {
      return (!p.keys().hasAny(['memberId']) || (p.memberId is string && isValidId(p.memberId))) &&
             (!p.keys().hasAny(['amount']) || (p.amount is number && p.amount > 0)) &&
             (!p.keys().hasAny(['date']) || (p.date is string)) &&
             (!p.keys().hasAny(['period']) || (p.period is string && p.period.size() < 100)) &&
             (!p.keys().hasAny(['type']) || (p.type in ['annual', 'monthly', 'dance']));
    }

    // 3. Settings Collection
    match /settings/{settingId} {
      allow read: if true; 
      allow create: if isAuthorized() && 
                      isValidId(settingId) && 
                      isValidSettings(incoming()) &&
                      (settingId == 'global');
      allow update: if isAuthorized() && 
                      isValidId(settingId) && 
                      isValidSettings(incoming()) &&
                      (settingId == 'global') &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'address', 'vatNumber', 'logoUrl', 'annualFee', 'monthlyFee', 'danceMonthlyFee']);
    }

    function isValidSettings(s) {
      return (!s.keys().hasAny(['name']) || (s.name is string && s.name.size() > 0)) &&
             (!s.keys().hasAny(['address']) || (s.address is string)) &&
             (!s.keys().hasAny(['vatNumber']) || (s.vatNumber is string)) &&
             (!s.keys().hasAny(['logoUrl']) || (s.logoUrl is string)) &&
             (!s.keys().hasAny(['annualFee']) || (s.annualFee is number && s.annualFee >= 0)) &&
             (!s.keys().hasAny(['monthlyFee']) || (s.monthlyFee is number && s.monthlyFee >= 0)) &&
             (!s.keys().hasAny(['danceMonthlyFee']) || (s.danceMonthlyFee is number && s.danceMonthlyFee >= 0));
    }
  }
}

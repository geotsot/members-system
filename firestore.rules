rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Since this is a internal system for a club, we assume access is restricted to club admins.
    // For now, we'll allow any signed-in user (the club staff) to access.
    // In a production app, we would check for specific UID or role.

    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidMember(incoming());
      allow update: if isSignedIn() && isValidMember(incoming());
      allow delete: if isSignedIn();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidPayment(incoming());
      allow update: if isSignedIn() && isValidPayment(incoming());
      allow delete: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    function isValidMember(m) {
      return m.fullName is string && m.fullName.size() > 0 && m.fullName.size() < 200 &&
             m.fatherName is string && m. fatherName.size() < 200 &&
             m.idNumber is string && m.idNumber.size() < 100 &&
             m.active is bool;
    }

    function isValidPayment(p) {
      return p.memberId is string &&
             p.amount is number && p.amount > 0 &&
             p.type in ['annual', 'monthly'];
    }
  }
}
